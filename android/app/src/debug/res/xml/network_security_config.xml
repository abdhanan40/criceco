<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY (src/debug): plain http to a local development backend
     — the local Supabase stack through `adb reverse` (127.0.0.1 / localhost)
     or the emulator's host alias (10.0.2.2). Every other host keeps Android's
     default (https only). Release and profile builds don't include this file;
     BackendConfig also refuses http for any other host. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
